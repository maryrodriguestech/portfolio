{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar backend (node server.js)",
            "type": "shell",
            "command": "npm start",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Servidor rodando"
                }
            }
        }
    ]
}